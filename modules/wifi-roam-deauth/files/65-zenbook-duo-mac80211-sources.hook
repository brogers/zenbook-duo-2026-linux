# zenbook-duo-2026-linux (wifi-roam-deauth): fetch the mac80211 sources of a new kernel
# before 70-dkms-install builds the patched mac80211. pacman 7.1 runs hooks without network
# access unless they ask for it; this one does, so the DKMS build never needs the network.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/build/include/

[Action]
Description = Fetching sources for the Zenbook Duo patched mac80211...
When = PostTransaction
Depends = git
NetworkAccess = allowed
Exec = /usr/bin/bash -c 'for b in /usr/src/zenbook-duo-mac80211-*/build.sh; do [[ -f $b ]] && exec /usr/bin/bash "$b" --fetch; done; exit 0'
NeedsTargets
