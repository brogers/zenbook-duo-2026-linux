#!/bin/bash
# zenbook-duo-2026-linux (display-zephyrus-bottom-edp): the LOBF-off udev rule (and its
# script) in the initramfs, so xe's panels have LOBF off before Plymouth draws the LUKS
# prompt. Needs the udev hook, whose settle runs before Plymouth starts.

build() {
    add_udev_rule /etc/udev/rules.d/90-zenbook-duo-zephyrus-lobf.rules
}

help() {
    cat <<HELPEOF
Turns LOBF off on the Zephyrus Duo's xe eDP panels in the initramfs, so the LUKS
prompt is visible. Installed by the display-zephyrus-bottom-edp module.
HELPEOF
}
