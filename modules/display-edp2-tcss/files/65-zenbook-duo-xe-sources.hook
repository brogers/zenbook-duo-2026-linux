# zenbook-duo-2026-linux (display-edp2-tcss): fetch the xe/i915 sources of a new kernel
# before 70-dkms-install builds the patched xe. pacman 7.1 runs hooks without network
# access unless they ask for it; this one does, so the DKMS build never needs the network.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/build/include/

[Action]
Description = Fetching sources for the Zenbook Duo patched xe...
When = PostTransaction
Depends = git
NetworkAccess = allowed
Exec = /usr/bin/bash -c 'for b in /usr/src/zenbook-duo-xe-*/build.sh; do [[ -f $b ]] && exec /usr/bin/bash "$b" --fetch; done; exit 0'
NeedsTargets
