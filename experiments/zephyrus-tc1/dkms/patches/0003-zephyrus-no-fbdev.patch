+/*
+ * ASUS Zephyrus Duo GX651AX: the console client lights every connected output,
+ * including the bottom panel on legacy TypeC port TC1, whenever no compositor
+ * holds the device (boot, compositor exit, shutdown). Enabling that panel again
+ * after it was turned off can hang its pipe, which hangs shutdown.
+ */
+static bool zephyrus_no_fbdev;
+module_param(zephyrus_no_fbdev, bool, 0444);
+MODULE_PARM_DESC(zephyrus_no_fbdev,
+		 "Don't start the fbdev console client on this device (default: false)");
+
 void intel_fbdev_setup(struct intel_display *display)
 {
 	struct intel_fbdev *ifbdev;
 	unsigned int preferred_bpp = 0;
 
-	if (!HAS_DISPLAY(display))
+	if (!HAS_DISPLAY(display) || zephyrus_no_fbdev)
 		return;
 
 	ifbdev = drmm_kzalloc(display->drm, sizeof(*ifbdev), GFP_KERNEL);
